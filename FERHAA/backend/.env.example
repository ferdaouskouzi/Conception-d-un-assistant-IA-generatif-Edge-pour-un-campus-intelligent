# Copiez ce fichier en .env et remplissez les valeurs réelles.
# Ne committez JAMAIS le fichier .env.

# Clé API Groq (https://console.groq.com)
GROQ_API_KEY=votre_cle_groq_ici

# Clé secrète Flask — générez-en une avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=votre_cle_secrete_ici

# Ollama local (mode dégradé sans internet)
# Laissez les valeurs par défaut si Ollama tourne sur la même machine
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Notifications email (optionnel — sans ces variables, les emails sont simulés dans les logs)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=votre_email@gmail.com
MAIL_PASSWORD=votre_mot_de_passe_application
MAIL_DEFAULT_SENDER=FERHAA <votre_email@gmail.com>

# Email de l'admin pédagogique qui reçoit les alertes réclamations
ADMIN_PEDAGOGUE_EMAIL=admin.pedagogique@ensabm.ma
